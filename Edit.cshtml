@{
    Layout = null;

    if (IsPost)
    {
        var connectionString = "Data Source=EAM\\SQLEXPRESS;Initial Catalog=internet_web;Integrated Security=True;";

        var firstName = Request["firstname"];
        var lastName = Request["lastname"];
        var email = Request["email"];
        var password = Request["password"];
        var phone = Request["phone"];
        var gender = Request["gender"];
        var age = Request["age"];
        var job = Request["job"];
        var role = Request["role"];

        using (var con = new System.Data.SqlClient.SqlConnection(connectionString))
        {
            con.Open();

            var query = @"UPDATE AppUsers
                          SET FirstName = @FirstName,
                              LastName = @LastName,
                              Password = @Password,
                              Phone = @Phone,
                              Gender = @Gender,
                              Age = @Age,
                              Job = @Job,
                              Role = @Role
                          WHERE Email = @Email";

            using (var cmd = new System.Data.SqlClient.SqlCommand(query, con))
            {
                cmd.Parameters.AddWithValue("@FirstName", firstName);
                cmd.Parameters.AddWithValue("@LastName", lastName);
                cmd.Parameters.AddWithValue("@Email", email);
                cmd.Parameters.AddWithValue("@Password", password);
                cmd.Parameters.AddWithValue("@Phone", phone);
                cmd.Parameters.AddWithValue("@Gender", gender);
                cmd.Parameters.AddWithValue("@Age", age);
                cmd.Parameters.AddWithValue("@Job", job);
                cmd.Parameters.AddWithValue("@Role", role);

                int rowsAffected = cmd.ExecuteNonQuery();

                if (rowsAffected > 0)
                {
                    Response.Redirect("Home.cshtml");
                }
                else
                {
                    <p style="color:red; text-align:center;">البريد الإلكتروني غير موجود في النظام.</p>
                }
            }
        }
    }
}

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>تعديل بيانات الحساب</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            background-color: #0F2944;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            font-family: 'Cairo', sans-serif;
            direction: rtl;
            padding-top: 60px;
        }

        .login {
            background-color: #ffffff;
            padding: 40px 50px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            width: 420px;
        }

            .login h1 {
                color: #2F4F4F;
                text-align: center;
                margin-bottom: 25px;
                font-size: 28px;
            }

        label {
            display: block;
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .login input,
        .login select {
            width: 100%;
            height: 45px;
            margin-bottom: 18px;
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 0 12px;
            font-size: 16px;
        }

        .gender {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
            color: #333;
        }

        .login button {
            width: 100%;
            height: 45px;
            border: none;
            border-radius: 10px;
            background-color: #556B2F;
            color: white;
            font-size: 17px;
            font-weight: bold;
            transition: 0.3s;
            cursor: pointer;
        }

            .login button:hover {
                background-color: #6B8E23;
                transform: scale(1.03);
            }

        .footer {
            text-align: center;
            margin-top: 15px;
        }

            .footer a {
                color: #556B2F;
                text-decoration: none;
                font-weight: bold;
            }
    </style>
</head>
<body>

    <div class="login">
        <h1>تعديل بيانات الحساب</h1>

        <form method="post">
            <label>الاسم الأول</label>
            <input type="text" name="firstname" placeholder="أدخل اسمك الأول" required>

            <label>الاسم الأخير</label>
            <input type="text" name="lastname" placeholder="أدخل اسمك الأخير" required>

            <label>البريد الإلكتروني</label>
            <input type="email" name="email" placeholder="example@email.com" required>

            <label>كلمة المرور</label>
            <input type="password" name="password" placeholder="أدخل كلمة المرور" required>

            <label>رقم الهاتف</label>
            <input type="tel" name="phone" placeholder="09XXXXXXXX" required>

            <label>الجنس</label>
            <div class="gender">
                <label><input type="radio" name="gender" value="ذكر"> ذكر</label>
                <label><input type="radio" name="gender" value="أنثى"> أنثى</label>
            </div>

            <label>العمر</label>
            <input type="number" name="age" placeholder="أدخل عمرك" required>

            <label>العمل</label>
            <select name="job" required>
                <option value="" disabled selected>اختر عملك</option>
                <option>طالب</option>
                <option>موظف</option>
                <option>عمل حر</option>
                <option>بدون عمل</option>
            </select>

            <label>الصلاحية</label>
            <select name="role" required>
                <option value="" disabled selected>اختر الصلاحية</option>
                <option value="Admin">Admin</option>
                <option value="Customer">Customer</option>
            </select>

            <button type="submit">تعديل</button>
        </form>
    </div>

</body>
</html>
