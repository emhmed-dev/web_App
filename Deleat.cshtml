@{
    Layout = null;

    if (IsPost)
    {
        var connectionString = "Data Source=EAM\\SQLEXPRESS;Initial Catalog=internet_web;Integrated Security=True;";

        var email = Request["email"];

        using (var con = new System.Data.SqlClient.SqlConnection(connectionString))
        {
            con.Open();

            var query = "DELETE FROM AppUsers WHERE Email = @Email";

            using (var cmd = new System.Data.SqlClient.SqlCommand(query, con))
            {
                cmd.Parameters.AddWithValue("@Email", email);

                int rows = cmd.ExecuteNonQuery();

                if (rows > 0)
                {
                    <script>alert('تم حذف المستخدم بنجاح!');</script>;
                }
                else
                {
                    <script>alert('لم يتم العثور على مستخدم بهذا البريد الإلكتروني!');</script>;
                }
            }
        }
    }
}

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>حذف مستخدم</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            background-color: #0F2944;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            font-family: 'Cairo', sans-serif;
            direction: rtl;
            padding-top: 60px;
        }

        .login {
            background-color: #ffffff;
            padding: 40px 50px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            width: 420px;
        }

            .login h1 {
                color: #2F4F4F;
                text-align: center;
                margin-bottom: 25px;
                font-size: 28px;
            }

        label {
            display: block;
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .login input {
            width: 100%;
            height: 45px;
            margin-bottom: 18px;
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 0 12px;
            font-size: 16px;
        }

        .login button {
            width: 100%;
            height: 45px;
            border: none;
            border-radius: 10px;
            background-color: #B22222;
            color: white;
            font-size: 17px;
            font-weight: bold;
            transition: 0.3s;
            cursor: pointer;
        }

            .login button:hover {
                background-color: #FF4500;
                transform: scale(1.03);
            }
    </style>
</head>
<body>

    <div class="login">
        <h1>حذف مستخدم</h1>

        <form method="post">
            <label>البريد الإلكتروني للمستخدم</label>
            <input type="email" name="email" placeholder="example@email.com" required>

            <button type="submit">حذف المستخدم</button>
        </form>
    </div>

</body>
</html>
