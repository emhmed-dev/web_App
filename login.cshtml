@{
    Layout = null;
    var loginMessage = "";

    if (Request.HttpMethod == "POST")
    {
        var email = Request.Form["email"];
        var password = Request.Form["password"];

        if (String.IsNullOrWhiteSpace(email) || String.IsNullOrWhiteSpace(password))
        {
            loginMessage = "  ادخل الايميل   .";
        }
        else
        {
            var connectionString = "Data Source=EAM\\SQLEXPRESS;Initial Catalog=internet_web;Integrated Security=True;";

            try
            {
                using (var con = new System.Data.SqlClient.SqlConnection(connectionString))
                {
                    con.Open();

                    var sql = "SELECT Id, FirstName, Role FROM AppUsers WHERE Email = @Email AND Password = @Password";

                    using (var cmd = new System.Data.SqlClient.SqlCommand(sql, con))
                    {
                        cmd.Parameters.AddWithValue("@Email", email.Trim());
                        cmd.Parameters.AddWithValue("@Password", password.Trim());

                        var reader = cmd.ExecuteReader();
                        if (reader.Read())
                        {
                            var userId = reader["Id"].ToString();
                            var firstName = reader["FirstName"].ToString();
                            var role = reader["Role"].ToString();

                            Session["UserId"] = userId;
                            Session["UserName"] = firstName;
                            Session["UserRole"] = role;

                        
                            if (role == "Admin")
                            {
                                Response.Redirect("Home.cshtml");   
                            }
                            else
                            {
                                Response.Redirect("product.cshtml"); 
                            }
                        }
                        else
                        {
                            loginMessage = "الإيميل أو كلمة المرور خطأ. إذا ماعندك حساب، اضغط إنشاء حساب جديد.";
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                loginMessage = "حصل خطأ بقاعدة البيانات: " + ex.Message;
            }
        }
    }
}

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>صفحة الدخول</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            background-color:   #0F2944 ;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Tahoma', sans-serif;
        }

        .login {
            background-color:#F5EFE6;
            padding: 30px 40px;
            border-radius: 20px;
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
            text-align: center;
            width: 320px;
        }

            .login h1 {
                color: #333;
                margin-bottom: 10px;
            }

            .login a {
                color: coral;
            }

            .login input {
                width: 92%;
                height: 40px;
                margin-bottom: 12px;
                border: none;
                border-radius: 10px;
                padding: 0 10px;
                background-color: #fff8dc;
                font-size: 16px;
            }

            .login button {
                width: 70%;
                height: 40px;
                border: none;
                border-radius: 10px;
                background-color: #556B2F;
                color: white;
                transition: 0.3s;
            }

                .login button:hover {
                    background-color: #6B8E23;
                    cursor: pointer;
              }
               

        .msg {
            color: #b22222;
            margin-bottom: 12px;
            font-size: 14px;
        }
    </style>
</head>

<body>
    <div class="login">
        <h1>تسجيل الدخول</h1>

        <h6>.</h6>
        @if (!String.IsNullOrEmpty(loginMessage))
        {
            <div class="msg">@loginMessage</div>
        }

        <form method="post" autocomplete="on">
            <input type="email" name="email" placeholder="الإيميل" required />
            <br />
            <input type="password" name="password" placeholder="كلمة المرور" required />
            <br />
           
            <button type="submit">دخول</button>
        </form>

        <p style="margin-top:12px;">ليس لديك حساب؟ <a href="Regester.cshtml">إنشاء حساب جديد</a></p>

    </div>
</body>
</html>
